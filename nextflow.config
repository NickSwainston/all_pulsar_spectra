// Nextflow configuration for fit_pulsars.nf

// Container image – matches the Dockerfile base used for this project
process {
    container = "nickswainston/pulsar_spectra:${params.version}"
}

// Enable Docker by default; comment out and enable singularity block instead
// if running on an HPC cluster.
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Singularity (HPC) – uncomment and disable the docker block above
// singularity {
//     enabled    = true
//     autoMounts = true
// }
